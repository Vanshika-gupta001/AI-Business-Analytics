# Copy this file to .env and fill in real values. Never commit .env.

# Required — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required — Postgres connection string
# Local dev example: postgresql://postgres:postgres@localhost:5432/analytics_db
DATABASE_URL=postgresql://user:password@localhost:5432/analytics_db

# Required — random secret used to sign JWT auth tokens
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_jwt_secret_here
# Optional — only needed in production deployments
FRONTEND_URL=https://your-app.vercel.app
BACKEND_BASE_URL=https://your-api.onrender.com
